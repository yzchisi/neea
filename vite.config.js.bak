  resolve: {
    alias: {
      '@': fileURLToPath(new URL('./src', import.meta.url)),
    },
  },
  css: {
    preprocessorOptions: {
      scss: {
        additionalData: `
          @use "@/assets/styles/_variables" as *;
          @use "@/assets/styles/_mixin" as *;
        `,
      },
    },
  },
